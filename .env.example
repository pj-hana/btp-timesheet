# WFS SOAP endpoint base (scheme + host + path prefix, no trailing operation segment).
# Per-operation endpoint is derived as: <base>/<Operation>.<Operation>HttpsSoap12Endpoint/
WFS_SOAP_ENDPOINT_BASE=https://origin-dev.au.wfs.cloud/workforce/services

# WS-Security UsernameToken (PasswordDigest) credentials, per API Specs/WFS_API_SOAPUI.xml.
# Do NOT reuse the credential embedded in that file (see plan open items — rotate it).
WFS_SOAP_USER=
WFS_SOAP_PASSWORD=
