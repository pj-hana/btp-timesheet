{
  "name": "timesheet",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.13.3",
    "express": "^4",
    "soap": "^1.9.3"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-typer": "^0.40",
    "@cap-js/cds-types": "^0.18",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "jest": "^30.4.2",
    "mbt": "^1.2.49",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-tsx serve",
    "watch": "cds-tsx w",
    "watch-timesheet-ui": "cds watch --open com.origin.timesheet.timesheetui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy timesheet --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "typecheck": "tsc",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "pretest": "cds compile srv/wfs/wfs-service.cds --to edmx > /dev/null && tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint srv/wfs test --ext .ts"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "bff-svc": {
              "roles": [
                "authenticated-user"
              ]
            }
          }
        },
        "[hybrid]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[production]": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true,
      "destinations": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
