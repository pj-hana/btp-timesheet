{
  "mcpServers": {
    "fiori-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sap-ux/fiori-mcp-server"
      ],
      "env": {
        "LOG_LEVEL": "error",
        "SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY": ""
      }
    },
    "cds-mcp": {
      "command": "npx",
      "args": ["-y", "@cap-js/mcp-server"],
      "env": {},
      "type": "stdio"
    }
  }
}